{
  "expo": {
    "name": "기타 코치 AI 완성형 베타",
    "slug": "guitar-coach-live-test",
    "version": "0.6.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "platforms": ["android"],
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "통기타와 일렉기타 연습 중 상체 자세와 손가락·피크를 휴대폰 안에서 분석하기 위해 카메라를 사용합니다.",
          "microphonePermission": "크로매틱 튜너와 연주 어택·박자 분석을 휴대폰 안에서 처리하기 위해 마이크를 사용합니다.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "android": {
      "package": "com.seungjae.guitarcoach.livetest",
      "versionCode": 5,
      "permissions": ["CAMERA", "RECORD_AUDIO"]
    }
  }
