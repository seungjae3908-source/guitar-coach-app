{
  "expo": {
    "name": "기타 코치 라이브 테스트",
    "slug": "guitar-coach-live-test",
    "version": "0.5.5",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "platforms": ["android"],
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "집중 연습 중 상체 자세를 화면에서 분석하기 위해 카메라를 사용합니다.",
          "microphonePermission": "이 테스트판은 마이크를 사용하지 않습니다.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "android": {
      "package": "com.seungjae.guitarcoach.livetest",
      "versionCode": 1,
      "permissions": ["CAMERA"]
    }
  }
}
