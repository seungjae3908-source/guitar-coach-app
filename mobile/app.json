{
  "expo": {
    "name": "기타 코치 AI",
    "slug": "guitar-coach-ai",
    "version": "0.3.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "platforms": ["android", "ios"],
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "기타 연습 영상을 촬영하기 위해 카메라를 사용합니다.",
          "microphonePermission": "기타 연주 소리를 함께 녹음하기 위해 마이크를 사용합니다.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "집중 연습의 박자와 음량을 분석하기 위해 마이크를 사용합니다.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "촬영한 기타 연습 영상을 확인하기 위해 미디어를 사용합니다.",
          "savePhotosPermission": "촬영한 기타 연습 영상을 휴대폰 갤러리에 저장합니다.",
          "granularPermissions": ["photo", "video"]
        }
      ]
    ],
    "android": {
      "package": "com.seungjae.guitarcoach",
      "versionCode": 4,
      "permissions": ["CAMERA", "RECORD_AUDIO"]
    },
    "ios": {
      "bundleIdentifier": "com.seungjae.guitarcoach",
      "buildNumber": "4"
    }
  }
}
