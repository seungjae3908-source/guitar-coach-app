{
  "name": "guitar-coach-complete-beta",
  "version": "0.6.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit && npm run quality:feedback",
    "quality:feedback": "rm -rf .quality-dist && tsc --strict --skipLibCheck --target ES2022 --module commonjs --moduleResolution node --lib ES2022,DOM --outDir .quality-dist services/feedback-stack-core.ts tests/feedback-stack-core.test.ts && node .quality-dist/tests/feedback-stack-core.test.js",
    "export:android": "expo export --platform android --output-dir dist"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.34",
    "expo-camera": "~17.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-haptics": "~15.0.8",
    "expo-media-library": "~18.2.1",
    "expo-video": "~3.0.16",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  }
}
