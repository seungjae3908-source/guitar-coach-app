{
  "name": "guitar-coach-mobile",
  "version": "0.5.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "postinstall": "node build-focus-ai.mjs",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "node build-focus-ai.mjs && tsc --noEmit",
    "export:android": "node build-focus-ai.mjs && expo export --platform android --output-dir dist"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.34",
    "expo-audio": "~1.1.1",
    "expo-camera": "~17.0.10",
    "expo-haptics": "~15.0.8",
    "expo-media-library": "~18.2.1",
    "react": "19.1.0",
    "react-native": "0.81.5"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  }
}
